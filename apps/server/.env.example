# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration
PORT=3000

# Optional AI limits (invalid values use the defaults shown).
# Output tokens include internal reasoning; increase for models needing more thinking time.
AI_MAX_TOKENS=4096
AI_MAX_RETRY_TOKENS=8192
AI_MAX_ATTEMPTS=3
AI_REQUEST_TIMEOUT_MS=45000
AI_MOVE_TIMEOUT_MS=120000
# Optional model ID used when a request does not select one.
# OPENROUTER_DEFAULT_MODEL=provider/model-id
